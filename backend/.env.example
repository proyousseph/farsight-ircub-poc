APP_NAME="IRCUB"
APP_ENV=local
APP_KEY=
# Set APP_DEBUG=false in staging/production to avoid stack-trace leakage.
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=ircub
DB_USERNAME=ircub
DB_PASSWORD=ircub_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ircub_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ircub.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Keep FRONTEND_URL host aligned with VITE_API_URL host (both localhost or both 127.0.0.1)
# so the HttpOnly ircub_token cookie is treated as same-site.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SANCTUM_TOKEN_EXPIRATION=480
SESSION_SECURE_COOKIE=false

# Channel integrations — REQUIRED in staging/production: unique secret >= 32 chars.
# Do not leave empty or use the mock default outside local/testing.
CHANNEL_CALLBACK_SECRET=
CHANNEL_ALLOW_SIMULATE=true
CHANNEL_CALLBACK_MAX_SKEW=300
CHANNEL_MOCK_BASE_URL=http://localhost:8001/mock-api

# 2FA: TOTP is the real path. Stub OTP is local/testing fallback only.
# Production: IRCUB_2FA_ALLOW_STUB=false and have users complete /api/auth/2fa/setup.
IRCUB_2FA_ENABLED=true
IRCUB_2FA_ALLOW_STUB=true
IRCUB_DEMO_OTP=123456

# OpenAPI/Swagger — force false in production.
IRCUB_DOCS_ENABLED=true

VITE_APP_NAME="${APP_NAME}"

