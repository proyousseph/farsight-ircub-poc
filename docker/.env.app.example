# Copy to docker/.env.app when using: docker compose --profile app up -d --build
#   cp docker/.env.app.example docker/.env.app
# Generate APP_KEY:  cd backend && php artisan key:generate --show
#
# Compose reads host/Project `.env` for ${VAR} interpolation. Values below are
# loaded into the container via env_file when not overridden in docker-compose.yml.
#
# Contabo / staging: keep APP_DEBUG=false, ALLOW_SIMULATE=false, stub/docs off,
# strong CHANNEL_CALLBACK_SECRET, CHANNEL_ALLOW_MOCK=false, FMIS_ALLOW_MOCK=false.

APP_NAME=IRCUB
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=

FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
SESSION_SECURE_COOKIE=false

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ircub
DB_USERNAME=ircub
DB_PASSWORD=ircub_secret

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ircub_redis_local
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Required: unique secret >= 32 chars (entrypoint generates ephemeral if missing/placeholder).
# Generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
CHANNEL_CALLBACK_SECRET=
CHANNEL_ALLOW_SIMULATE=false
CHANNEL_ALLOW_MOCK=true
FMIS_ALLOW_MOCK=true
CHANNEL_MOCK_BASE_URL=http://api:8000/mock-api

IRCUB_AUTH_COOKIE_SAMESITE=lax
IRCUB_MAX_UNLINKED_PAYMENT=100000

IRCUB_2FA_ENABLED=true
IRCUB_2FA_ALLOW_STUB=false
IRCUB_DEMO_OTP=
IRCUB_DOCS_ENABLED=false
IRCUB_SEED_ON_BOOT=true

# --- Optional local lab (set in Project/.env so compose ${} picks them up) ---
# APP_DEBUG=true
# CHANNEL_ALLOW_SIMULATE=true
# IRCUB_2FA_ALLOW_STUB=true
# IRCUB_DEMO_OTP=123456
# IRCUB_DOCS_ENABLED=true
