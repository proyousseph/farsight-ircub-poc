# Copy to docker/.env.app when using: docker compose --profile app up -d --build
#   cp docker/.env.app.example docker/.env.app
# Generate APP_KEY:  cd backend && php artisan key:generate --show
# Compose also reads APP_KEY from the shell environment if set.

APP_NAME=IRCUB
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
SESSION_SECURE_COOKIE=false

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ircub
DB_USERNAME=ircub
DB_PASSWORD=ircub_secret

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

CHANNEL_CALLBACK_SECRET=change-me-to-a-long-random-secret-32chars
CHANNEL_ALLOW_SIMULATE=true
CHANNEL_MOCK_BASE_URL=http://api:8000/mock-api

IRCUB_2FA_ENABLED=true
IRCUB_2FA_ALLOW_STUB=true
IRCUB_DEMO_OTP=123456
IRCUB_DOCS_ENABLED=true
IRCUB_SEED_ON_BOOT=true
