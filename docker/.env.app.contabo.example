# Contabo / https://ircub.waagefaal.so
# Copy to BOTH Project/.env (compose ${} interpolation) and docker/.env.app
#   cp docker/.env.app.contabo.example .env
#   cp docker/.env.app.contabo.example docker/.env.app
# Then fill APP_KEY, CHANNEL_CALLBACK_SECRET, POSTGRES_PASSWORD, REDIS_PASSWORD on the VPS.

APP_NAME=IRCUB
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ircub.waagefaal.so
APP_KEY=

FRONTEND_URL=https://ircub.waagefaal.so
SANCTUM_STATEFUL_DOMAINS=ircub.waagefaal.so
SESSION_SECURE_COOKIE=true

POSTGRES_PASSWORD=
REDIS_PASSWORD=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ircub
DB_USERNAME=ircub
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

CHANNEL_CALLBACK_SECRET=
CHANNEL_ALLOW_SIMULATE=false
# POC demo: in-process mocks (no live bank/MM/FMIS). Mock status checks stay PENDING
# until a signed HMAC callback settles SUCCESS with a matching amount.
CHANNEL_ALLOW_MOCK=true
FMIS_ALLOW_MOCK=true
CHANNEL_MOCK_BASE_URL=http://api:8000/mock-api

IRCUB_AUTH_COOKIE_SAMESITE=lax
IRCUB_MAX_UNLINKED_PAYMENT=100000

IRCUB_2FA_ENABLED=true
IRCUB_2FA_ALLOW_STUB=false
IRCUB_DEMO_OTP=
IRCUB_DOCS_ENABLED=false
# Keep seeded Password@123 usable for assessors (avoids first visitor locking demo).
IRCUB_DEMO_SKIP_PASSWORD_CHANGE=true
# First boot only: true once, then set false permanently on the VPS.
IRCUB_SEED_ON_BOOT=false
# Settlement: mocks do not auto-SUCCESS. Use signed HMAC callback (or local simulate).

# SSI / edge proxy — override with real upstream IPs if not behind a private docker network.
TRUSTED_PROXIES=*

IRCUB_WEB_BIND=127.0.0.1
