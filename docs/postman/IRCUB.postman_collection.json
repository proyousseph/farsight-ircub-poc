{
  "info": {
    "name": "IRCUB API",
    "description": "Farsight Africa IRCUB POC — Bearer-first. Login with X-IRCUB-Return-Token: 1 stores `token`. Cookie jar is cleared after login so Origin CSRF does not block API tools. Change-password captures a fresh token. Logout is last.\n\nOpenAPI: docs/openapi.yaml · Swagger (local): http://127.0.0.1:8001/docs/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8001" },
    { "key": "token", "value": "" },
    { "key": "origin", "value": "http://localhost:5173" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }",
                  "try {",
                  "  const jar = pm.cookies.jar();",
                  "  jar.clear(pm.request.url, function () {});",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-IRCUB-Return-Token", "value": "1" },
              { "key": "Origin", "value": "{{origin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ircub.test\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Change password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }",
                  "try {",
                  "  const jar = pm.cookies.jar();",
                  "  jar.clear(pm.request.url, function () {});",
                  "} catch (e) {}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-IRCUB-Return-Token", "value": "1" },
              { "key": "Origin", "value": "{{origin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"Password@123\",\n  \"password\": \"Password@1234\",\n  \"password_confirmation\": \"Password@1234\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/password"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Payers & Revenue",
      "item": [
        {
          "name": "List payers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/payers?per_page=10"
          }
        },
        {
          "name": "List assessments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/assessments"
          }
        },
        {
          "name": "List payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/payments"
          }
        }
      ]
    },
    {
      "name": "Water",
      "item": [
        {
          "name": "List meter readings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/meter-readings"
          }
        },
        {
          "name": "List water bills",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/water-bills"
          }
        }
      ]
    },
    {
      "name": "Channels",
      "item": [
        {
          "name": "FX rates",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/channel/rates?quote=SOS"
          }
        },
        {
          "name": "List channel payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/channel/payments"
          }
        }
      ]
    },
    {
      "name": "FMIS",
      "item": [
        {
          "name": "List GL mappings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/gl-mappings"
          }
        },
        {
          "name": "List FMIS batches",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/fmis/batches"
          }
        },
        {
          "name": "FMIS reconciliation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/fmis/reconciliation?date=2026-10-07"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard snapshot",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/dashboard"
          }
        },
        {
          "name": "Dashboard alerts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/dashboard/alerts"
          }
        }
      ]
    },
    {
      "name": "Mock APIs",
      "item": [
        {
          "name": "Mock rates",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/mock-api/rates?quote=SOS"
          }
        },
        {
          "name": "Mock FMIS journals by date",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/mock-api/fmis/journals?date=2026-10-07"
          }
        }
      ]
    },
    {
      "name": "Auth (end)",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Origin", "value": "{{origin}}" }
            ],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    }
  ]
}
